WIDTH=16;
DEPTH=65536;

ADDRESS_RADIX=HEX;
DATA_RADIX=HEX;

CONTENT BEGIN
    00 : 0000; -- .word 0
    01 : 0022; -- .word 0x22
    02 : 0000; -- .space 4
    03 : 0000; -- .space 4
    04 : 0000; -- .space 4
    05 : 0000; -- .space 4
    06 : 1234; -- .word 0x1234
    07 : 5678; -- .word 0x5678

    [08..FFFF] : 0000;
END;
